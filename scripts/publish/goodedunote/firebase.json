{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "redirects": [
      { "source": "/taipei-current-zhongshan-datong", "destination": "/puma-policy-treasure/session-1.html", "type": 301 },
      { "source": "/taipei-current-zhongshan-datong/", "destination": "/puma-policy-treasure/session-1.html", "type": 301 },
      { "source": "/taipei-current-zhongshan-datong/index.html", "destination": "/puma-policy-treasure/session-1.html", "type": 301 }
    ],
    "headers": [
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
